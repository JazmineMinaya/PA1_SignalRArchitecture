@page

@{
    ViewData["Title"] = "Pedidos en vivo";
}

<h1>Pedidos en tiempo real</h1>

<div>
    <label for="orderId">Número de pedido:</label>
    <input id="orderId" type="number" min="1" value="1" />
</div>

<div>
    <label for="orderStatus">Estado:</label>
    <select id="orderStatus">
        <option value="Pendiente">Pendiente</option>
        <option value="En preparación">En preparación</option>
        <option value="Enviado">Enviado</option>
        <option value="Entregado">Entregado</option>
    </select>
</div>

<button id="updateButton" disabled>
    Actualizar pedido
</button>

<p id="connectionStatus">Conectando...</p>

<h3>Notificaciones de pedidos</h3>

<ul id="ordersList"></ul>

<script 
    src="~/js/signalr/dist/browser/signalr.min.js">
</script>
<script src="~/js/orders.js"></script>
